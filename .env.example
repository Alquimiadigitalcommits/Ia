# ─── WhatsApp Cloud API (Meta for Developers) ───
# Token permanente de un "usuario del sistema" en Business Manager
WHATSAPP_TOKEN=
# ID del número (no es el número de teléfono). Panel de WhatsApp > Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú; lo pegas igual en el panel de Webhooks de Meta
WHATSAPP_VERIFY_TOKEN=alquimia-cambia-esto
# App > Configuración > Básica > Clave secreta de la app (para validar la firma)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ─── Notion ───
# notion.so/my-integrations > nueva integración interna > copiar el secret
NOTION_TOKEN=
# ID de la base "Banco de ideas" (los 32 caracteres de la URL)
NOTION_DATABASE_ID=
# ID de la base personal "Ideas TikTok" (opcional)
NOTION_TIKTOK_DATABASE_ID=

# ─── Claude ───
ANTHROPIC_API_KEY=

# ─── Quién puede escribir al bot ───
# JSON: número (formato internacional sin +) -> nombre y rol.
# rol "equipo" = Alquimia (puede indicar cliente con #NombreCliente); rol "cliente" = la marca.
# destino "tiktok" = lo que mande ese número va a "Ideas TikTok" (salvo si empieza con "agencia:").
CONTACTOS_JSON={"56911111111":{"nombre":"Tamara","rol":"equipo","destino":"tiktok"},"56922222222":{"nombre":"Marca X","rol":"cliente","cliente":"Marca X"}}
# Los clientes y su ficha (rubro, público, temas, tono, qué evitar) se editan en clientes.json

# ─── Dashboard "Mi día" (bases creadas en la página privada "Mi día" de Notion) ───
# La integración de Notion debe estar conectada a la página "Mi día" (••• → Conexiones).
NOTION_DB_REGISTRO=4186150dcd6881a1b5c8edf404e38586
NOTION_DB_MEDICAMENTOS=4186150dcd6881189f8bfefbe19d5800
NOTION_DB_PLAN=4186150dcd68815ab28ac4d480a188aa
NOTION_DB_FECHAS=4186150dcd688124afdcf62ac7051849
NOTION_DB_CICLO=4186150dcd688164b499fe7d5782602b
NOTION_DB_LECTURAS=4186150dcd6881a2b9f8c38b420b8116
NOTION_DB_FINANZAS_PERSONALES=4186150dcd6881029cebc7fd355e1fda
# Opcional: base Proyectos de la agencia
NOTION_DB_PROYECTOS=
# Clave para abrir el dashboard y las alarmas (mínimo 8 caracteres). Inventa una larga.
DASHBOARD_CLAVE=
# Nombre en el saludo (opcional)
NOMBRE_DASHBOARD=
ZONA_HORARIA=America/Santiago
