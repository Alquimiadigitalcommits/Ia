# ─── WhatsApp Cloud API (Meta for Developers) ───
# Token permanente de un "usuario del sistema" en Business Manager
WHATSAPP_TOKEN=
# ID del número (no es el número de teléfono). Panel de WhatsApp > Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=
# Texto que inventas tú; lo pegas igual en el panel de Webhooks de Meta
WHATSAPP_VERIFY_TOKEN=alquimia-cambia-esto
# App > Configuración > Básica > Clave secreta de la app (para validar la firma)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ─── Notion ───
# notion.so/my-integrations > nueva integración interna > copiar el secret
NOTION_TOKEN=
# ID de la base "Banco de ideas" (los 32 caracteres de la URL)
NOTION_DATABASE_ID=

# ─── Claude ───
ANTHROPIC_API_KEY=

# ─── Quién puede escribir al bot ───
# JSON: número (formato internacional sin +) -> nombre y rol.
# rol "equipo" = Alquimia (puede indicar cliente con #NombreCliente); rol "cliente" = la marca.
CONTACTOS_JSON={"56911111111":{"nombre":"Tamara","rol":"equipo"},"56922222222":{"nombre":"Marca X","rol":"cliente","cliente":"Marca X"}}
# Lista de clientes válidos (Claude solo puede elegir uno de estos)
CLIENTES=Alquimia Digital,Tamara (creadora),Marca X
