# Copia este archivo como .env (en tu computador) o carga estas variables en Netlify.
# Nunca subas el .env a GitHub: está en .gitignore.

# ─── Claude ───
ANTHROPIC_API_KEY=

# ─── WhatsApp Cloud API (Meta for Developers) ───
WHATSAPP_TOKEN=                  # token permanente de un usuario del sistema
WHATSAPP_PHONE_NUMBER_ID=        # ID del número (no el número)
WHATSAPP_VERIFY_TOKEN=           # texto que inventas y pegas igual en Meta
WHATSAPP_APP_SECRET=             # para validar que los mensajes vienen de Meta
WHATSAPP_API_VERSION=v21.0

# Quién puede escribir al bot. Número internacional sin "+".
# rol "equipo": Alquimia (puede asignar cliente con #Nombre). rol "cliente": sus ideas van a su ficha.
# "cliente" debe ser el nombre exacto que aparece en clientes.json.
CONTACTOS_JSON={"56900000000":{"nombre":"Tamara","rol":"equipo"},"56900000001":{"nombre":"Angelo","rol":"cliente","cliente":"Plasok"}}

# ─── Notion ───
# notion.so/my-integrations → integración interna. Conéctala (••• → Conexiones) a:
# "Agencia Digital | Centro de Operaciones" y a la página "Mi día".
NOTION_TOKEN=
NOTION_DB_IDEAS=c2b5071b2e6d48c384d748b77ac1ab8b        # Ideas y referencias (ya existe)

# Dashboard "Mi día"
NOTION_DB_REGISTRO=4186150dcd6881a1b5c8edf404e38586
NOTION_DB_MEDICAMENTOS=4186150dcd6881189f8bfefbe19d5800
NOTION_DB_PLAN=4186150dcd68815ab28ac4d480a188aa
NOTION_DB_FECHAS=4186150dcd688124afdcf62ac7051849
NOTION_DB_CICLO=4186150dcd688164b499fe7d5782602b
NOTION_DB_LECTURAS=4186150dcd6881a2b9f8c38b420b8116
NOTION_DB_FINANZAS_PERSONALES=4186150dcd6881029cebc7fd355e1fda
NOTION_DB_PROYECTOS=                                    # opcional

DASHBOARD_CLAVE=                 # mínimo 8 caracteres; protege salud y alarmas
NOMBRE_DASHBOARD=
ZONA_HORARIA=America/Santiago
