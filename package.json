{
  "name": "alquimia-ideas-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp que guarda ideas de contenido en Notion, clasificadas con Claude",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch scripts/local-server.ts",
    "start": "tsx scripts/local-server.ts",
    "probar": "tsx scripts/probar-clasificacion.ts",
    "importar": "tsx scripts/importar-chat.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "vitest run",
    "revisar": "tsc --noEmit && tsc --noEmit -p app && vitest run",
    "dev:app": "vite",
    "build": "vite build",
    "migrar": "tsx scripts/migrar.ts",
    "local": "tsx scripts/servidor-local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@netlify/blobs": "^11.1.9",
    "@supabase/supabase-js": "^2.119.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@netlify/functions": "^6.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
