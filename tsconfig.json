{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "scripts",
    "netlify",
    "tests",
    "shared",
    "clientes.json"
  ],
  "exclude": [
    "app",
    "dist",
    "node_modules"
  ]
}